# Copie para ".env" (nesta pasta) para rodar o servidor em DESENVOLVIMENTO:  npm run migrate:dev  e  npm run dev
# O arquivo .env não deve ser compartilhado nem versionado (já está no .gitignore).

# Banco local (crie antes: CREATE DATABASE elo3d_dev;)
DATABASE_URL=postgres://postgres:SUA_SENHA@127.0.0.1:5432/elo3d_dev

# Qualquer texto aleatório com 32+ caracteres (só para o ambiente de desenvolvimento)
JWT_SECRET=troque-por-um-texto-aleatorio-bem-grande-1234567890

# Código para criar conta/redefinir senha. Dica: depois de criar a sua conta, apague esta linha e reinicie
# o servidor: sem ele o cadastro e a redefinição ficam desativados (importante se você expuser o servidor por túnel).
CODIGO_CONVITE=dev-convite-troque

PORT=3001

# Duração da sessão (opcionais; valores abaixo são os padrões)
# SESSAO_INATIVIDADE_MIN=60   # minutos sem usar o sistema até expirar
# SESSAO_MAXIMA_HORAS=12      # duração máxima da sessão, mesmo com uso contínuo
