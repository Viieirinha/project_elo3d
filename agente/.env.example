# Copie este arquivo para ".env" (na mesma pasta) e preencha. O arquivo .env NÃO deve ser compartilhado.

# Endereço do sistema ELO 3D
ELO_API_URL=https://elo3d.wmbens.cloud

# Token do agente: gere em Configurações > Impressora, no sistema (aparece uma única vez)
ELO_AGENT_TOKEN=elo3d_ag_COLE_AQUI

# Código de verificação (checkCode) da impressora: menu da impressora > Configurações > Rede/Código.
# Fica SOMENTE neste notebook: nunca é enviado ao sistema.
FF_CHECK_CODE=COLE_AQUI

# Opcionais
# FF_TIMEOUT_MS=4000
# ELO_LOG_ARQUIVO=agente.log
